# Clave del servidor. No la pongas en el cliente ni en el repositorio.
OPENAI_API_KEY=

# Modelo de voz. El default es el realtime mini vigente.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
OPENAI_VOICE_SPEED=0.92
OPENAI_SUMMARY_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_NOISE_REDUCTION=far_field

# Postgres en el deploy. Vacío: SQLite local en data/charla.sqlite.
DATABASE_URL=

# PIN familiar. Protege /setup y el inicio de la voz.
SETUP_PIN=

APP_TIMEZONE=America/Montevideo
SILENCE_CLOSE_SECONDS=75

# Opcional. Sin esto, la alerta queda guardada y no se envía.
NOTIFY_WEBHOOK_URL=

# Solo desarrollo local.
CHARLA_DB_PATH=
